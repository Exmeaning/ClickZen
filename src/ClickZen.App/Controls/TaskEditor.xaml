<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClickZen.App.Controls.TaskEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Root condition group of a task / rule -->
        <Style x:Key="EditorRootGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <!-- Nested condition group: accent bar on the left shows nesting -->
        <Style x:Key="EditorSubGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8,8,8" />
        </Style>
        <!-- Condition / action card -->
        <Style x:Key="EditorItemCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <!-- Rule card -->
        <Style x:Key="EditorRuleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <!-- RandomOne branch card -->
        <Style x:Key="EditorBranchCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style x:Key="EditorPreviewStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="EditorSwatchStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="EditorErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="EditorCautionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="EditorSuccessTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="EditorErrorIconStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style x:Key="EditorCautionIconStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        </Style>
        <Style x:Key="EditorSuccessIconStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style x:Key="EditorSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="EditorNumberStyle" TargetType="NumberBox">
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            <Setter Property="ValidationMode" Value="InvalidInputOverwritten" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBlock x:Name="EmptyText" x:Uid="Editor_Placeholder"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Style="{StaticResource SecondaryCaptionTextBlockStyle}" />

        <ScrollViewer x:Name="Scroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel x:Name="Sections" Spacing="12" Padding="0,0,12,16">

                <!-- ============================== Basic info -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Uid="Editor_BasicHeader" Style="{StaticResource EditorSectionTitleStyle}" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="2" x:Name="EnabledSwitch" x:Uid="Editor_TaskEnabled" MinWidth="0"
                                          VerticalAlignment="Center" Toggled="OnEnabledToggled" />
                        </Grid>
                        <TextBox x:Name="NameBox" x:Uid="Editor_TaskName" TextChanged="OnNameChanged" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox x:Name="CooldownBox" x:Uid="Editor_Cooldown" Style="{StaticResource EditorNumberStyle}"
                                       Minimum="0" Maximum="86400000" SmallChange="100" LargeChange="1000"
                                       ValueChanged="OnCooldownChanged" />
                            <NumberBox Grid.Column="1" x:Name="PriorityBox" x:Uid="Editor_Priority" Style="{StaticResource EditorNumberStyle}"
                                       Minimum="-1000" Maximum="1000" SmallChange="1" LargeChange="10"
                                       ValueChanged="OnPriorityChanged" />
                            <NumberBox Grid.Column="2" x:Name="RunLimitBox" x:Uid="Editor_RunLimit" Style="{StaticResource EditorNumberStyle}"
                                       Minimum="0" Maximum="1000000" SmallChange="1" LargeChange="10"
                                       ValueChanged="OnRunLimitChanged" />
                        </Grid>
                        <TextBlock x:Uid="Editor_BasicHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <!-- ============================== Precondition -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE71C;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Uid="Editor_PreconditionHeader" Style="{StaticResource EditorSectionTitleStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Uid="Editor_PreconditionHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        <ContentControl x:Name="PreconditionHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                    </StackPanel>
                </Border>

                <!-- ============================== Rules -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8FD;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" x:Uid="Editor_RulesHeader" Style="{StaticResource EditorSectionTitleStyle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <Button x:Name="ExpandAllButton" Style="{StaticResource SubtleButtonStyle}" Padding="7,6" Click="OnExpandAllClick">
                                    <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                                </Button>
                                <Button x:Name="CollapseAllButton" Style="{StaticResource SubtleButtonStyle}" Padding="7,6" Click="OnCollapseAllClick">
                                    <FontIcon Glyph="&#xE71D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Uid="Editor_RulesHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        <ContentControl x:Name="RulesHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
