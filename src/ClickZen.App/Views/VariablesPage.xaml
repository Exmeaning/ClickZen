<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClickZen.App.Views.VariablesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ClickZen.App.ViewModels"
    xmlns:local="using:ClickZen.App.Views"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls">

    <Page.Resources>
        <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock x:Uid="Page_Variables_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="Page_Variables_Description" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
        </StackPanel>

        <!-- Variable table -->
        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis">
                    <Run x:Uid="Vars_SchemeLabel" /><Run Text="{x:Bind ViewModel.SchemeName, Mode=OneWay}" />
                </TextBlock>
                <ComboBox x:Name="ViewPicker" Grid.Column="1" x:Uid="Vars_ViewPicker" MinWidth="220"
                          ItemsSource="{x:Bind ViewModel.Views}" SelectedItem="{x:Bind ViewModel.SelectedView, Mode=TwoWay}"
                          DisplayMemberPath="Label" />
                <Button Grid.Column="2" x:Uid="Vars_Add" Command="{x:Bind ViewModel.AddVariableCommand}" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock x:Uid="Vars_AddText" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Column headers -->
            <Grid Grid.Row="1" Padding="16,0,16,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="120" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="1.2*" MinWidth="90" />
                    <ColumnDefinition Width="1.5*" MinWidth="110" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="Vars_ColName" Style="{StaticResource ColumnHeaderStyle}" />
                <TextBlock Grid.Column="1" x:Uid="Vars_ColType" Style="{StaticResource ColumnHeaderStyle}" />
                <TextBlock Grid.Column="2" x:Uid="Vars_ColScope" Style="{StaticResource ColumnHeaderStyle}" />
                <TextBlock Grid.Column="3" x:Uid="Vars_ColSync" Style="{StaticResource ColumnHeaderStyle}" />
                <TextBlock Grid.Column="4" x:Uid="Vars_ColInitial" Style="{StaticResource ColumnHeaderStyle}" />
                <TextBlock Grid.Column="5" x:Uid="Vars_ColValue" Style="{StaticResource ColumnHeaderStyle}" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <ListView x:Name="RowList" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Single"
                              SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="16,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:VariableRow">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="120" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="1.2*" MinWidth="90" />
                                        <ColumnDefinition Width="1.5*" MinWidth="110" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Declared: editable; runtime-only: read-only name with a hint -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBox Text="{x:Bind Name, Mode=TwoWay}" IsEnabled="{x:Bind IsDeclared}"
                                                 FontFamily="{StaticResource MonoFontFamily}" />
                                        <TextBlock Text="{x:Bind NameError, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Visibility="{x:Bind local:VariablesPage.VisibleIfText(NameError), Mode=OneWay}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedIndex="{x:Bind TypeIndex, Mode=TwoWay}" IsEnabled="{x:Bind IsDeclared}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ComboBoxItem x:Uid="Vars_TypeInt" />
                                        <ComboBoxItem x:Uid="Vars_TypeDouble" />
                                        <ComboBoxItem x:Uid="Vars_TypeBool" />
                                        <ComboBoxItem x:Uid="Vars_TypeString" />
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" SelectedIndex="{x:Bind ScopeIndex, Mode=TwoWay}" IsEnabled="{x:Bind IsDeclared}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ComboBoxItem x:Uid="Vars_ScopeScheme" />
                                        <ComboBoxItem x:Uid="Vars_ScopeGlobal" />
                                    </ComboBox>
                                    <ComboBox Grid.Column="3" SelectedIndex="{x:Bind SyncIndex, Mode=TwoWay}" IsEnabled="{x:Bind IsDeclared}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                        <ComboBoxItem x:Uid="Vars_SyncNone" />
                                        <ComboBoxItem x:Uid="Vars_SyncSend" />
                                        <ComboBoxItem x:Uid="Vars_SyncReceive" />
                                        <ComboBoxItem x:Uid="Vars_SyncBoth" />
                                    </ComboBox>
                                    <TextBox Grid.Column="4" Text="{x:Bind Initial, Mode=TwoWay}" IsEnabled="{x:Bind IsDeclared}"
                                             FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="5" Text="{x:Bind CurrentValue, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}"
                                             VerticalAlignment="Center" Tag="{x:Bind}" x:Uid="Vars_ValueBox"
                                             KeyDown="OnValueKeyDown" LostFocus="OnValueLostFocus" />
                                    <Button Grid.Column="6" Padding="6" VerticalAlignment="Center" Tag="{x:Bind}" Click="OnRowMenuClick"
                                            Background="Transparent" BorderThickness="0" x:Uid="Vars_RowMore">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText" x:Uid="Vars_Empty" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" x:Uid="Vars_TableHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="Wrap" />
        </Grid>

        <!-- Sync service card -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
                <ctk:SettingsCard x:Uid="Vars_SyncCard">
                    <ctk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </ctk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="SyncToggle" IsOn="{x:Bind ViewModel.SyncEnabled, Mode=TwoWay}" />
                </ctk:SettingsCard>
                <InfoBar x:Name="SyncStatusBar" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                         Severity="{x:Bind local:VariablesPage.StatusSeverity(ViewModel.IsRunning, ViewModel.SyncError), Mode=OneWay}" />

                <ctk:SettingsCard x:Uid="Vars_PortCard">
                    <NumberBox Value="{x:Bind ViewModel.Port, Mode=TwoWay}" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact"
                               MinWidth="120" />
                </ctk:SettingsCard>

                <ctk:SettingsExpander x:Uid="Vars_TokenCard" IsExpanded="True">
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard ContentAlignment="Left">
                            <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                <PasswordBox x:Name="TokenBox" Password="{x:Bind ViewModel.Token, Mode=TwoWay}" x:Uid="Vars_TokenBox"
                                             PasswordRevealMode="Peek" MinWidth="260" FontFamily="{StaticResource MonoFontFamily}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleButton x:Uid="Vars_TokenShow" Click="OnShowTokenClick">
                                        <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                    </ToggleButton>
                                    <Button x:Uid="Vars_TokenRegenerate" Command="{x:Bind ViewModel.RegenerateTokenCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                            <TextBlock x:Uid="Vars_TokenRegenerateText" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Uid="Vars_TokenCopy" Click="OnCopyTokenClick">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <Button x:Uid="Vars_Apply" Command="{x:Bind ViewModel.ApplySyncSettingsCommand}" HorizontalAlignment="Right" />

                <ctk:SettingsCard x:Uid="Vars_AddressCard">
                    <ctk:SettingsCard.Description>
                        <TextBlock Text="{x:Bind ViewModel.AddressesText, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </ctk:SettingsCard.Description>
                </ctk:SettingsCard>

                <ctk:SettingsExpander x:Uid="Vars_ClientsCard" IsExpanded="True">
                    <ctk:SettingsExpander.Items>
                        <ctk:SettingsCard ContentAlignment="Left">
                            <Grid>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Clients}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoClientsText" x:Uid="Vars_NoClients" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                            </Grid>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

                <HyperlinkButton x:Uid="Vars_ProtocolLink" Click="OnProtocolClick" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
