<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>

    <Product>ClickZen</Product>
    <Company>Exmeaning</Company>
    <Authors>Exmeaning</Authors>
    <Copyright>Copyright (c) Exmeaning</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Exmeaning/ClickZen</RepositoryUrl>

    <!-- CI overrides with -p:Version=x.y.z from the git tag -->
    <Version Condition="'$(Version)' == ''">2.0.0-dev</Version>

    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>

  <!-- Recommended analyzers are noisy for app code; keep the ones that matter as errors. -->
  <PropertyGroup>
    <!-- CA1848/CA1873: LoggerMessage delegates – acceptable for this app's log volume. -->
    <!-- CA1515: types in apps do not need to be internal. -->
    <!-- CA2007: ConfigureAwait – app code, not a library. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1515;CA2007;CA1303;CA1031;CA1716;CA1711;CA1720;CA1002;CA2227;CA1819;CA1805;CA1062;CA1305;CA1307;CA1309;CA1310;CA1822;CA1859;CA1861;CA5394;CA1024;CA1708;CA1034;CA1724;CA1056;CA1054;CA1055;CA2201;CA1051;CA1707;CA1814;CA1028;CA1008;CA2225;CA1000;CA1003;CA1063;CA1816;CA2213;CA1001;CA1513;CA1512;CA1510;CA1863;CA1869;CA2263;CA1823;CA1852;CA1812</NoWarn>
  </PropertyGroup>
</Project>
