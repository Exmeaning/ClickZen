<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClickZen.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:ClickZen.App.Services"
    xmlns:vm="using:ClickZen.App.ViewModels"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Page_Devices_Title" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="Page_Devices_Description" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" VerticalAlignment="Center">
                <AppBarButton x:Uid="Devices_AddWireless" Click="OnAddWirelessClick">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE701;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="Devices_Refresh" Command="{x:Bind ViewModel.RefreshCommand}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind HasMessage(ViewModel.Message), Mode=OneWay}"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                 Severity="{x:Bind Severity(ViewModel.MessageIsError), Mode=OneWay}"
                 CloseButtonClick="OnMessageClosed" />

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="24">
                <!-- Connected devices -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Devices_ConnectedHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Border Style="{StaticResource CardBorderStyle}"
                            Visibility="{x:Bind svc:DeviceUi.NotTrue(ViewModel.HasDevices), Mode=OneWay}">
                        <StackPanel Spacing="8" Padding="8">
                            <TextBlock x:Uid="Devices_EmptyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Uid="Devices_EmptyHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="340" MinItemHeight="150" MinColumnSpacing="12" MinRowSpacing="12"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="svc:DeviceEntry">
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind svc:DeviceUi.KindGlyph(Info.Kind), Mode=OneWay}" FontSize="24" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Info.DisplayName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Serial, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" FontFamily="{StaticResource MonoFontFamily}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Padding="8,2" CornerRadius="10" VerticalAlignment="Top"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind IsCurrent, Mode=OneWay}">
                                                <TextBlock x:Uid="Devices_CurrentBadge" Style="{StaticResource CaptionTextBlockStyle}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{x:Bind svc:DeviceUi.Details(Info), Mode=OneWay}"
                                                   Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind svc:DeviceUi.StateBrush(Info.State, SessionState), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind svc:DeviceUi.StateText(Info.State, SessionState, SessionError), Mode=OneWay}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                                            <Button x:Uid="Devices_StartMirror" Style="{StaticResource AccentButtonStyle}"
                                                    Visibility="{x:Bind svc:DeviceUi.CanStart(Info.State, Session), Mode=OneWay}"
                                                    Click="OnStartMirrorClick" Tag="{x:Bind}" />
                                            <Button x:Uid="Devices_StopMirror"
                                                    Visibility="{x:Bind svc:DeviceUi.HasSession(Session), Mode=OneWay}"
                                                    Click="OnStopMirrorClick" Tag="{x:Bind}" />
                                            <Button x:Uid="Devices_SetCurrent"
                                                    Visibility="{x:Bind svc:DeviceUi.NotTrue(IsCurrent), Mode=OneWay}"
                                                    Click="OnSetCurrentClick" Tag="{x:Bind}" />
                                            <Button x:Uid="Devices_DisconnectWireless"
                                                    Visibility="{x:Bind svc:DeviceUi.IsNetwork(Info.Kind), Mode=OneWay}"
                                                    Click="OnDisconnectWirelessClick" Tag="{x:Bind}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Saved wireless devices -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Devices_SavedHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Devices_SavedEmpty" Style="{StaticResource SecondaryCaptionTextBlockStyle}"
                               Visibility="{x:Bind svc:DeviceUi.NotTrue(ViewModel.HasSaved), Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Saved}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SavedDeviceItem">
                                <ctk:SettingsCard Header="{x:Bind Name}" Description="{x:Bind Address}">
                                    <ctk:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE701;" />
                                    </ctk:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                                        <CheckBox x:Uid="Devices_AutoConnect" IsChecked="{x:Bind Model.AutoConnect, Mode=OneWay}"
                                                  Click="OnToggleAutoConnectClick" Tag="{x:Bind}" MinWidth="0" />
                                        <Button x:Uid="Devices_Connect" Click="OnConnectSavedClick" Tag="{x:Bind}"
                                                IsEnabled="{x:Bind svc:DeviceUi.Not(IsConnected), Mode=OneWay}" />
                                        <Button Click="OnRemoveSavedClick" Tag="{x:Bind}" x:Uid="Devices_RemoveSaved">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </ctk:SettingsCard>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
