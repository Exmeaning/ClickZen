<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ClickZen.App.Views.AddWirelessDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClickZen.App.Views"
    x:Uid="AddWireless_Dialog"
    DefaultButton="None"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid MinWidth="480" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Uid="AddWireless_TabQr" Tag="qr" IsSelected="True" />
            <SelectorBarItem x:Uid="AddWireless_TabDirect" Tag="direct" />
            <SelectorBarItem x:Uid="AddWireless_TabPair" Tag="pair" />
            <SelectorBarItem x:Uid="AddWireless_TabScan" Tag="scan" />
        </SelectorBar>

        <!-- QR Code Pairing + LAN mDNS Discovery (All-in-One) -->
        <StackPanel x:Name="QrPanel" Grid.Row="1" Spacing="12">
            <TextBlock x:Uid="AddWireless_QrHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="Wrap" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="8" CornerRadius="8" Background="#FFFFFFFF" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Top">
                    <Image x:Name="QrImage" Width="168" Height="168" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="QrStatusText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="QrCodeMetaText" Style="{StaticResource SecondaryCaptionTextBlockStyle}" FontFamily="{StaticResource MonoFontFamily}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <Button x:Name="RefreshQrButton" x:Uid="AddWireless_QrRefresh" Click="OnRefreshQrClick" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="AddWireless_LanHeader" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="RefreshLanButton" x:Uid="AddWireless_LanRefresh" Grid.Column="1" Click="OnRefreshLanClick" />
            </Grid>
            <TextBlock x:Name="LanEmptyText" x:Uid="AddWireless_LanEmpty" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="Wrap" />
            <ListView x:Name="LanDevicesList" MaxHeight="140" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:DiscoveredLanDeviceItem">
                        <Grid Padding="0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Address}" FontFamily="{StaticResource MonoFontFamily}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Uid="Devices_Connect" Click="OnConnectLanItemClick" Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Direct connect -->
        <StackPanel x:Name="DirectPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Uid="AddWireless_DirectHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            <TextBox x:Name="DirectAddress" x:Uid="AddWireless_Address" />
            <TextBox x:Name="DirectName" x:Uid="AddWireless_SaveAs" />
            <Button x:Name="DirectConnect" x:Uid="AddWireless_ConnectButton" Style="{StaticResource AccentButtonStyle}" Click="OnDirectConnect" />
        </StackPanel>

        <!-- Pairing (Android 11+) -->
        <StackPanel x:Name="PairPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Uid="AddWireless_PairHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PairAddress" x:Uid="AddWireless_PairAddress" />
                <TextBox x:Name="PairCode" x:Uid="AddWireless_PairCode" Grid.Column="1" MaxLength="10" />
            </Grid>
            <Button x:Name="PairButton" x:Uid="AddWireless_PairButton" Style="{StaticResource AccentButtonStyle}" Click="OnPair" />
            <TextBlock x:Uid="AddWireless_PairThenConnect" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PairConnectAddress" x:Uid="AddWireless_ConnectAddress" />
                <Button x:Name="PairConnectButton" x:Uid="AddWireless_ConnectButton" Grid.Column="1" Click="OnPairConnect" />
            </Grid>
        </StackPanel>

        <!-- Emulator scan -->
        <StackPanel x:Name="ScanPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Uid="AddWireless_ScanHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            <Button x:Name="ScanButton" x:Uid="AddWireless_ScanButton" Style="{StaticResource AccentButtonStyle}" Click="OnScan" />
            <ListView x:Name="ScanResults" MaxHeight="200" SelectionMode="None" />
            <TextBlock x:Uid="AddWireless_PresetsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="PresetList" Style="{StaticResource SecondaryCaptionTextBlockStyle}" IsTextSelectionEnabled="True" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <ProgressRing x:Name="Busy" Width="16" Height="16" IsActive="False" />
            <TextBlock x:Name="Result" TextWrapping="Wrap" MaxWidth="440" />
        </StackPanel>
    </Grid>
</ContentDialog>
