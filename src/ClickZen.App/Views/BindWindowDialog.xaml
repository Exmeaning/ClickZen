<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ClickZen.App.Views.BindWindowDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:local="using:ClickZen.App.Views"
    x:Uid="Window_Dialog"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick"
    Closing="OnClosing">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">980</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <Grid Width="760" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="560" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step indicator -->
        <BreadcrumbBar x:Name="Steps" ItemClicked="OnStepClicked" />

        <TextBlock x:Name="StepHint" Grid.Row="1" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="Wrap" />

        <!-- Step 1: window -->
        <Grid x:Name="WindowStep" Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WindowFilter" x:Uid="Window_Filter" TextChanged="OnFilterChanged" />
                    <Button Grid.Column="1" x:Uid="Window_RefreshWindows" Click="OnRefreshWindows">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>
                <ListView x:Name="WindowList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnWindowSelected"
                          BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:WindowChoice">
                            <Grid Padding="0,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Uid="Window_PreviewHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" CornerRadius="8">
                    <Image x:Name="Thumbnail" Stretch="Uniform" Margin="4" />
                    <TextBlock x:Name="ThumbnailPlaceholder" x:Uid="Window_PreviewNone" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <TextBlock x:Name="ThumbnailInfo" Grid.Row="2" Style="{StaticResource SecondaryCaptionTextBlockStyle}" FontFamily="{StaticResource MonoFontFamily}" />
            </Grid>
        </Grid>

        <!-- Step 2: area -->
        <Grid x:Name="AreaStep" Grid.Row="2" RowSpacing="8" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="Window_UseClientArea" Click="OnUseClientArea">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE740;" FontSize="14" />
                        <TextBlock x:Uid="Window_UseClientAreaText" />
                    </StackPanel>
                </Button>
                <Button x:Uid="Window_Recapture" Click="OnRecapture">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE722;" FontSize="14" />
                        <TextBlock x:Uid="Window_RecaptureText" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" CornerRadius="8">
                <canvas:CanvasControl x:Name="AreaCanvas" Draw="OnAreaDraw" ClearColor="Transparent"
                                      PointerPressed="OnAreaPressed" PointerMoved="OnAreaMoved"
                                      PointerReleased="OnAreaReleased" PointerCanceled="OnAreaReleased" PointerCaptureLost="OnAreaReleased" />
                <TextBlock x:Name="AreaPlaceholder" x:Uid="Window_AreaNoPicture" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="AreaInfo" Grid.Row="2" Style="{StaticResource SecondaryCaptionTextBlockStyle}" FontFamily="{StaticResource MonoFontFamily}" />
        </Grid>

        <!-- Step 3: linked device and reference resolution -->
        <StackPanel x:Name="DeviceStep" Grid.Row="2" Spacing="16" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="Window_AdbHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Uid="Window_AdbHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="Wrap" />
                <ComboBox x:Name="AdbCombo" MinWidth="360" SelectionChanged="OnAdbSelected" />
            </StackPanel>
            <StackPanel Spacing="8">
                <TextBlock x:Uid="Window_RefHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Uid="Window_RefHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox x:Name="RefWidth" x:Uid="Window_RefWidth" Minimum="0" Maximum="16384" SmallChange="1" Width="140"
                               SpinButtonPlacementMode="Compact" ValueChanged="OnRefChanged" />
                    <FontIcon Glyph="&#xE711;" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                    <NumberBox x:Name="RefHeight" x:Uid="Window_RefHeight" Minimum="0" Maximum="16384" SmallChange="1" Width="140"
                               SpinButtonPlacementMode="Compact" ValueChanged="OnRefChanged" />
                    <Button x:Name="RefFromAdb" x:Uid="Window_RefFromAdb" VerticalAlignment="Bottom" Click="OnRefFromAdb">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                    </Button>
                    <Button x:Uid="Window_RefFromFrame" VerticalAlignment="Bottom" Click="OnRefFromFrame">
                        <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="RefInfo" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- Step 4: name -->
        <StackPanel x:Name="NameStep" Grid.Row="2" Spacing="16" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
            <TextBox x:Name="NameBox" x:Uid="Window_Name" MinWidth="360" />
            <StackPanel Spacing="8">
                <TextBlock x:Uid="Window_MatchHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Uid="Window_MatchHint" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="Wrap" />
                <TextBox x:Name="MatchTitle" x:Uid="Window_MatchTitle" />
                <TextBox x:Name="MatchProcess" x:Uid="Window_MatchProcess" />
                <TextBox x:Name="MatchClass" x:Uid="Window_MatchClass" />
            </StackPanel>
            <TextBlock x:Name="Summary" Style="{StaticResource SecondaryCaptionTextBlockStyle}" FontFamily="{StaticResource MonoFontFamily}" TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar x:Name="Problem" Grid.Row="3" Severity="Warning" IsClosable="False" />
    </Grid>
</ContentDialog>
